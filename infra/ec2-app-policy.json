{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GenerateInventoryNarratives",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:*::foundation-model/amazon.nova-micro-v1:0"
    },
    {
      "Sid": "SendInventoryReports",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "*"
    }
  ]
}
