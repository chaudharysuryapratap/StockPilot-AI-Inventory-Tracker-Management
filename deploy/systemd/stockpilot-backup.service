[Unit]
Description=Back up the StockPilot MariaDB database to S3
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/backup-stockpilot
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/stockpilot
