# Application
APP_ENV=development
AUTO_CREATE_SCHEMA=true
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///inventory.db
MAX_PRODUCT_CSV_BYTES=2097152
MAX_PRODUCT_CSV_ROWS=1000

# Set this to a MySQL RDS endpoint in production. Do not commit a real password.
# DATABASE_URL=mysql+pymysql://inventory_admin:CHANGE_ME@your-rds-endpoint:3306/inventory_tracker

# POS / scheduled-job protection
POS_WEBHOOK_TOKEN=replace-with-a-long-random-pos-token
INTERNAL_API_TOKEN=replace-with-a-long-random-job-token

# Named staff accounts and role permissions. Keep authentication enabled.
# Leave the legacy fields blank for a new install; create the first admin in
# /signup or with `flask --app run create-admin` before exposing the service.
STAFF_AUTH_ENABLED=true
ALLOW_WEB_SIGNUP=true
# Trusted API clients normally use the durable machine actor. Enable this only
# if a private integration must attribute actions to named staff accounts.
ALLOW_ACTOR_HEADER=false
STAFF_USERNAME=
STAFF_PASSWORD=
DEFAULT_WORKSPACE_NAME=StockPilot Workspace
DEFAULT_BUSINESS_USERNAME=stockpilot
DEFAULT_STAFF_EMAIL=staff@stockpilot.local
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=30
INVITATION_EXPIRY_HOURS=72
AUTH_EMAIL_ENABLED=false
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
MFA_ISSUER=StockPilot
OIDC_ENABLED=true
SESSION_COOKIE_SECURE=false
# Comma-separated hostnames accepted by Flask in production, for example:
# TRUSTED_HOSTS=inventory.example.com
TRUSTED_HOSTS=
TRUST_PROXY_HEADERS=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
SIGNUP_MAX_ATTEMPTS=5
SIGNUP_WINDOW_SECONDS=3600
AUTH_LINK_MAX_ATTEMPTS=3
AUTH_LINK_WINDOW_SECONDS=900
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# Forecasting defaults
FORECAST_LOOKBACK_DAYS=28
DEFAULT_SUPPLIER_LEAD_TIME_DAYS=3
CRITICAL_STOCKOUT_DAYS=3
NEAR_EXPIRY_DAYS=30
DEAD_STOCK_DAYS=90
FORECAST_ACCURACY_HORIZON_DAYS=7
REPORT_CURRENCY=INR

# AWS: use an EC2 IAM role in production rather than static access keys.
AWS_REGION=ap-south-1
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
ASSISTANT_MAX_REQUESTS_PER_MINUTE=15
SES_ENABLED=false
SES_FROM_EMAIL=verified-sender@example.com
ALERT_RECIPIENTS=owner@example.com
